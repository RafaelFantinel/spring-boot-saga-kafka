<mxCell id="legend" value="&lt;b&gt;Local &amp;rarr; AWS mapping&lt;/b&gt;&lt;br&gt;postgres:16 &amp;rarr; RDS PostgreSQL &amp;nbsp;|&amp;nbsp; Kafka KRaft &amp;rarr; Amazon MSK &amp;nbsp;|&amp;nbsp; Zipkin &amp;rarr; ADOT sidecar + X-Ray &amp;nbsp;|&amp;nbsp; Prometheus &amp;rarr; AMP &amp;nbsp;|&amp;nbsp; Grafana &amp;rarr; AMG &amp;nbsp;|&amp;nbsp; k8s Services &amp;rarr; ECS Service Connect (Cloud Map)&lt;br&gt;Each Fargate task runs the Spring Boot container + an ADOT collector sidecar. Only order-service is exposed through the ALB; all other traffic stays inside the private subnets." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="1040" width="1630" height="80" as="geometry"/></mxCell>
